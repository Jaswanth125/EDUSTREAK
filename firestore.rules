rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─── HELPER FUNCTIONS ──────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) ?
             get(/databases/$(database)/documents/users/$(userId)).data : {};
    }
    
    function getCurrentUser() {
      return getUserData(request.auth.uid);
    }
    
    function isAdmin() {
      return isAuthenticated() && getCurrentUser().role == 'admin';
    }
    
    function isPrincipal() {
      return isAuthenticated() && getCurrentUser().role == 'principal';
    }
    
    function isTeacher() {
      return isAuthenticated() && getCurrentUser().role == 'teacher';
    }
    
    function isStudent() {
      return isAuthenticated() && getCurrentUser().role == 'student';
    }
    
    function isParent() {
      return isAuthenticated() && getCurrentUser().role == 'parent';
    }

    function isTeacherOrPrincipalOrAdmin() {
      return isAuthenticated() && (getCurrentUser().role in ['teacher', 'principal', 'admin']);
    }

    // ─── USERS COLLECTION ──────────────────────────────────────────────────
    match /users/{userId} {
      // Must be authenticated to read user profiles (roster, leaderboard, chat, portal data)
      allow read: if isAuthenticated();
      
      // Users can create their own doc on signup, and Admins/Principals can register users
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isPrincipal());
      
      // Users can update their own data, Admins/Principals can manage, Teachers can update for grading/streaks
      allow update: if isAuthenticated() && (
        isOwner(userId) || 
        isAdmin() ||
        isPrincipal() ||
        isTeacher()
      );
      
      // Only Admins can delete users
      allow delete: if isAdmin();
      
      // Subcollection: Attendance Records
      match /attendanceRecords/{dateKey} {
        allow read: if isAuthenticated();
        allow create, update: if isTeacherOrPrincipalOrAdmin();
        allow delete: if isAdmin();
      }

      // Subcollection: Topic Completions
      match /topic_completions/{topicId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (request.auth.uid == userId || isTeacherOrPrincipalOrAdmin());
      }

      // Recursive catch-all for student/user subcollections (skillMatrix, metrics, etc.)
      match /{allUserSubcollections=**} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (request.auth.uid == userId || isTeacherOrPrincipalOrAdmin());
      }
    }

    // ─── SCHOOLS COLLECTION ────────────────────────────────────────────────
    match /schools/{schoolId} {
      // Public read for school code verification during student login & dropdowns
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isPrincipal() && getCurrentUser().schoolId == schoolId);

      // School Announcements Subcollection
      match /announcements/{announcementId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin() || (isPrincipal() && getCurrentUser().schoolId == schoolId);
      }

      // AI Generated Tasks Subcollection
      match /ai_generated_tasks/{taskId} {
        allow read: if isAuthenticated();
        allow create, delete: if isTeacherOrPrincipalOrAdmin();
        allow update: if isAuthenticated() && (
          isTeacherOrPrincipalOrAdmin() ||
          (isStudent() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedBy', 'studentAnswers']))
        );
      }

      // Recursive catch-all for other school-scoped subcollections
      match /{allChildren=**} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || (isPrincipal() && getCurrentUser().schoolId == schoolId);
      }
    }

    // ─── CURRICULUM TEMPLATES COLLECTION ───────────────────────────────────
    match /curriculum_templates/{templateId} {
      allow read: if isAuthenticated();
      // Only Central Admins can modify global curriculum templates
      allow write: if isAdmin();
    }
    
    // ─── ATTENDANCE SUMMARY COLLECTION ──────────────────────────────────────
    match /attendanceSummary/{summaryId} {
      allow read: if isAuthenticated();
      allow create, update: if isTeacherOrPrincipalOrAdmin();
      allow delete: if isAdmin();
    }
    
    // ─── TASKS COLLECTION ──────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isTeacherOrPrincipalOrAdmin();
      allow update: if isAuthenticated() && (
        isTeacherOrPrincipalOrAdmin() ||
        (isStudent() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submissions', 'proofUrls', 'submissionTexts']))
      );
      allow delete: if isTeacherOrPrincipalOrAdmin();
    }
    
    // ─── CHALLENGES COLLECTION ─────────────────────────────────────────────
    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow create: if isTeacherOrPrincipalOrAdmin();
      allow update: if isAuthenticated() && (
        isTeacherOrPrincipalOrAdmin() ||
        (isStudent() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completions']))
      );
      allow delete: if isTeacherOrPrincipalOrAdmin();
    }
    
    // ─── CLASSES COLLECTION ────────────────────────────────────────────────
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isTeacherOrPrincipalOrAdmin();
    }
    
    // ─── STORE & GAMIFICATION ASSETS ───────────────────────────────────────
    match /store/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /store/avatars {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      
      match /items/{avatarId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }
    
    match /store/badges {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      
      match /items/{badgeId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }
    
    // ─── CHATS & MESSAGES ──────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participants || isAdmin());
      allow delete: if isAuthenticated() && (request.auth.uid in resource.data.participants || isAdmin());
      
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.senderId;
        allow update: if isAuthenticated() && (
          request.auth.uid == resource.data.senderId ||
          isAdmin() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'read', 'readBy'])
        );
        allow delete: if isAuthenticated() && (request.auth.uid == resource.data.senderId || isAdmin());
      }
    }
    
    // ─── SUPPORT & TICKETS ─────────────────────────────────────────────────
    match /support_info/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // ─── PLATFORM SETTINGS ─────────────────────────────────────────────────
    match /platform_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── AUDIT LOGS (IMMUTABLE) ────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ─── ROSTER STUDENTS ───────────────────────────────────────────────────
    match /roster_students/{rosterId} {
      allow read: if true;
      allow create, update, delete: if isTeacherOrPrincipalOrAdmin();
    }

    // ─── ROSTER TEACHERS ───────────────────────────────────────────────────
    match /roster_teachers/{rosterId} {
      allow read: if true;
      allow create, update, delete: if isPrincipal() || isAdmin();
    }

    // ─── INVITATIONS ───────────────────────────────────────────────────────
    match /invitations/{invitationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isPrincipal();
    }

    // ─── VERIFICATION CHALLENGES ───────────────────────────────────────────
    match /verification_challenges/{challengeId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // ─── IMPORT BATCHES ────────────────────────────────────────────────────
    match /import_batches/{batchId} {
      allow read, create, update: if isPrincipal() || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── ASSESSMENTS COLLECTION ─────────────────────────────────────────────
    match /assessments/{assessmentId} {
      allow read: if isAuthenticated();
      allow create, delete: if isTeacherOrPrincipalOrAdmin();
      allow update: if isAuthenticated() && (
        isTeacherOrPrincipalOrAdmin() ||
        (isStudent() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submissions']))
      );
    }

    // ─── LEARNING RESOURCES COLLECTION ──────────────────────────────────────
    match /learning_resources/{resourceId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isTeacherOrPrincipalOrAdmin();
    }

    // ─── IN-APP NOTIFICATIONS COLLECTION ────────────────────────────────────
    match /in_app_notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ─── XP TRANSACTIONS (IMMUTABLE LEDGER) ─────────────────────────────────
    match /xp_transactions/{txId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isTeacherOrPrincipalOrAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ─── ACADEMIC YEARS ────────────────────────────────────────────────────
    match /academic_years/{yearId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── ATTENDANCE CORRECTIONS ────────────────────────────────────────────
    match /attendance_corrections/{correctionId} {
      allow read: if isAuthenticated();
      allow create, update: if isTeacherOrPrincipalOrAdmin();
      allow delete: if isAdmin();
    }

    // ─── MAIL DISPATCH QUEUE ───────────────────────────────────────────────
    match /mail/{mailId} {
      allow read, write: if isAuthenticated();
    }
  }
}

